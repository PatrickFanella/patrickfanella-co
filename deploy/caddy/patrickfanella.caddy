patrickfanella.co {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://plausible.io; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'self'; img-src 'self' data:; object-src 'self'; script-src 'self' https://plausible.io; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@api path /api/*
	handle @api {
		reverse_proxy 10.0.0.56:3017
	}

	handle {
		reverse_proxy 10.0.0.56:3016
	}
}
